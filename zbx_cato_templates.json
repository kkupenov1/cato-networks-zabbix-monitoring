        "templates": [
            {
                "uuid": "f6371fa399df4c3596482e03f6b394e3",
                "template": "Template Cato CMA",
                "name": "Template Cato CMA (Main)",
                "description": "Main template for monitoring Cato Networks via the GraphQL API. Attach this to a single host that MUST be named 'Cato Networks Cloud'. It polls the API once, then auto-discovers every active site and socket as its own Zabbix host and applies the 'Template Cato Site' / 'Template Cato Socket' templates to them. Set the {$CATO.ACCOUNT.ID} and {$CATO.API.KEY} macros before enabling.",
                "groups": [
                    {
                        "name": "Templates/Network devices"
                    }
                ],
                "items": [
                    {
                        "uuid": "4a8926e345bc421eb54e9aa12f47c622",
                        "name": "Cato Networks API data",
                        "type": "HTTP_AGENT",
                        "key": "cato.api.data",
                        "delay": "55s",
                        "history": "1d",
                        "value_type": "TEXT",
                        "trends": "0",
                        "url": "https://api.catonetworks.com/api/v1/graphql2",
                        "description": "Master item. Polls the Cato Networks GraphQL API once and stores the raw JSON snapshot of all sites, sockets and interfaces. Every other metric in these templates is derived from this single request via dependent items and preprocessing, so the API is only called once per interval.",
                        "posts": "{\n    \"query\": \"query GetSitesAndSockets { accountSnapshot(accountID: \\\"{$CATO.ACCOUNT.ID}\\\") { sites { id info { name description connType type } connectivityStatus operationalStatus devices { id identifier socketInfo { serial version platform isPrimary } connected lastConnected deviceUptime interfaces { id name connected tunnelRemoteIP tunnelUptime popName } } } } }\"\n}",
                        "headers": [
                            {
                                "name": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "name": "x-api-key",
                                "value": "{$CATO.API.KEY}"
                            }
                        ],
                        "request_method": "POST",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "api"
                            }
                        ]
                    }
                ],
                "discovery_rules": [
                    {
                        "uuid": "c5716576b0a343a8a4a17ac1837f358b",
                        "name": "Cato Remote Sites Discovery",
                        "type": "DEPENDENT",
                        "key": "cato.site.discovery",
                        "delay": "0",
                        "lifetime_type": "DELETE_NEVER",
                        "lifetime": "0",
                        "enabled_lifetime_type": "DISABLE_NEVER",
                        "description": "Discovers all Cato connected sites.",
                        "host_prototypes": [
                            {
                                "uuid": "4ff67d4ee9e54b5e94537315f5d371a8",
                                "host": "Cato Site - {#SITE_NAME}",
                                "name": "Cato Site - {#SITE_NAME}",
                                "inventory_mode": "AUTOMATIC",
                                "group_links": [
                                    {
                                        "group": {
                                            "name": "Network devices/Cato sites"
                                        }
                                    }
                                ],
                                "group_prototypes": [
                                    {
                                        "name": "Sites/{#GROUP_SITE_NAME}"
                                    }
                                ],
                                "templates": [
                                    {
                                        "name": "Template Cato Site"
                                    }
                                ],
                                "macros": [
                                    {
                                        "macro": "{$CONN_TYPE}",
                                        "value": "{#CONN_TYPE}"
                                    },
                                    {
                                        "macro": "{$FULL_SITE_NAME}",
                                        "value": "{#FULL_SITE_NAME}"
                                    },
                                    {
                                        "macro": "{$GROUP_SITE_NAME}",
                                        "value": "{#GROUP_SITE_NAME}"
                                    },
                                    {
                                        "macro": "{$SITE_ID}",
                                        "value": "{#SITE_ID}"
                                    },
                                    {
                                        "macro": "{$SITE_NAME}",
                                        "value": "{#SITE_NAME}"
                                    }
                                ],
                                "tags": [
                                    {
                                        "tag": "assignment_group",
                                        "value": "Zabbix Alarms"
                                    },
                                    {
                                        "tag": "class",
                                        "value": "network"
                                    },
                                    {
                                        "tag": "device_type",
                                        "value": "cato site"
                                    },
                                    {
                                        "tag": "site",
                                        "value": "{#GROUP_SITE_NAME}"
                                    }
                                ]
                            }
                        ],
                        "master_item": {
                            "key": "cato.api.data"
                        },
                        "lld_macro_paths": [
                            {
                                "lld_macro": "{#CONN_TYPE}",
                                "path": "$.connType"
                            },
                            {
                                "lld_macro": "{#FULL_SITE_NAME}",
                                "path": "$.fullSiteName"
                            },
                            {
                                "lld_macro": "{#GROUP_SITE_NAME}",
                                "path": "$.groupSiteName"
                            },
                            {
                                "lld_macro": "{#SITE_ID}",
                                "path": "$.siteId"
                            },
                            {
                                "lld_macro": "{#SITE_NAME}",
                                "path": "$.siteName"
                            }
                        ],
                        "preprocessing": [
                            {
                                "type": "JAVASCRIPT",
                                "parameters": [
                                    "var result = [];\nvar data = JSON.parse(value);\nvar sites = data.data.accountSnapshot.sites;\nfor (var i = 0; i < sites.length; i++) {\n    var site = sites[i];\n    if (site.operationalStatus === \"active\") {\n        var shortSiteName = (site.info.name.split(', ')[1] || site.info.name).replace(/[()]/g, '');\n        var fullSiteName = site.info.name.replace(/, /g, '/').replace(/[()]/g, '');\n        var groupSiteName = site.info.name.replace(/, /g, '/');\n        result.push({\n            fullSiteName: fullSiteName,\n            siteName: shortSiteName,\n            groupSiteName: groupSiteName,\n            siteId: site.id,\n            connType: site.info.connType\n        });\n    }\n}\nreturn JSON.stringify(result);"
                                ]
                            }
                        ]
                    },
                    {
                        "uuid": "1ad9bbf33068434cad592e0612f5af28",
                        "name": "Cato Socket Discovery",
                        "type": "DEPENDENT",
                        "key": "cato.socket.discovery",
                        "delay": "0",
                        "lifetime_type": "DELETE_NEVER",
