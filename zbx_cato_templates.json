                        "name": "Interfaces discovery",
                        "type": "DEPENDENT",
                        "key": "cato.interface.discovery",
                        "delay": "0",
                        "lifetime_type": "DELETE_NEVER",
                        "lifetime": "0",
                        "enabled_lifetime_type": "DISABLE_NEVER",
                        "description": "Discovers all interfaces on this Cato Networks socket.",
                        "item_prototypes": [
                            {
                                "uuid": "34742a6c326147838a403e4fd8af3d62",
                                "name": "Interface {#INTERFACE_NAME} connectivity status",
                                "type": "DEPENDENT",
                                "key": "cato.interface.connectivity[{#INTERFACE_ID}]",
                                "delay": "0",
                                "value_type": "FLOAT",
                                "preprocessing": [
                                    {
                                        "type": "JSONPATH",
                                        "parameters": [
                                            "$..[?(@.id==\"{#INTERFACE_ID}\")].connected.first()"
                                        ]
                                    },
                                    {
                                        "type": "JAVASCRIPT",
                                        "parameters": [
                                            "return value === \"true\" ? 1 : 0;"
                                        ]
                                    }
                                ],
                                "master_item": {
                                    "key": "cato.api.data.local"
                                },
                                "tags": [
                                    {
                                        "tag": "component",
                                        "value": "interface"
                                    }
                                ],
                                "trigger_prototypes": [
                                    {
                                        "uuid": "97ae2968d918435e9cee7923d37cd9dc",
                                        "expression": "count(/Template Cato Socket/cato.interface.connectivity[{#INTERFACE_ID}],5m,\"eq\",\"0\")>=5",
                                        "recovery_mode": "RECOVERY_EXPRESSION",
                                        "recovery_expression": "count(/Template Cato Socket/cato.interface.connectivity[{#INTERFACE_ID}],2m,\"eq\",\"1\")>=2",
                                        "name": "{$TYPE} Cato Socket ({$SERIAL}) @ {$FULL_SITE_NAME} - Interface {#INTERFACE_NAME} is down",
                                        "priority": "AVERAGE",
                                        "description": "The WAN Interface is down for more than 5 minutes. Review the switch it connects to or verify direct ISP connection using topologies. If linked to the core switch, check the physical connection first, then the port to the ISP.",
                                        "dependencies": [
                                            {
                                                "name": "{$TYPE} Cato Socket ({$SERIAL}) @ {$FULL_SITE_NAME} - Socket is disconnected",
                                                "expression": "count(/Template Cato Socket/cato.socket.connectivity,3m,\"eq\",\"0\")>=3",
                                                "recovery_expression": "count(/Template Cato Socket/cato.socket.connectivity,2m,\"eq\",\"1\")>=2"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ],
                        "master_item": {
                            "key": "cato.api.data.local"
                        },
                        "lld_macro_paths": [
                            {
                                "lld_macro": "{#INTERFACE_ID}",
                                "path": "$.id"
                            },
                            {
                                "lld_macro": "{#INTERFACE_NAME}",
                                "path": "$.name"
                            }
                        ],
                        "preprocessing": [
                            {
                                "type": "JAVASCRIPT",
                                "parameters": [
                                    "var data = JSON.parse(value);\nvar result = [];\nif (data && data.interfaces && Array.isArray(data.interfaces)) {\n    for (var i = 0; i < data.interfaces.length; i++) {\n        var iface = data.interfaces[i];\n        if (iface) {\n            result.push({\n                id: iface.id || '',\n                name: iface.name || '',\n                connected: iface.connected || false,\n                tunnelRemoteIP: iface.tunnelRemoteIP || '',\n                tunnelUptime: iface.tunnelUptime || 0,\n                popName: iface.popName || ''\n            });\n        }\n    }\n}\nreturn JSON.stringify(result);"
                                ]
                            }
                        ]
                    }
