                        "enabled_lifetime_type": "DISABLE_NEVER",
                        "description": "Discovers all Cato Networks sockets (X1500/X1600) in sites.",
                        "host_prototypes": [
                            {
                                "uuid": "e4074c985c1e4893bb3dd78453259b31",
                                "host": "{#TYPE} Cato Socket - {#SITE_NAME}",
                                "name": "{#TYPE} Cato Socket - {#SITE_NAME}",
                                "inventory_mode": "AUTOMATIC",
                                "group_links": [
